APP_NAME="就活マネージャー"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tokyo

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shukatsu_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log

# --- Login -------------------------------------------------------------
# Only these Google accounts may sign in (comma separated).
ALLOWED_LOGIN_EMAILS=
# Local only: show a "dev login" button (ignored unless APP_ENV=local).
DEV_LOGIN_ENABLED=false

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
GOOGLE_CONNECT_REDIRECT_URI=/settings/google/callback

VITE_APP_NAME="${APP_NAME}"

# OpenAI（メールの判定・日時の抜き出し・除外ルールの作成）
# ※変数名に SHUKATSU_ を付けているのは、Windowsの環境変数 OPENAI_API_KEY（他のプロジェクト用）が .env より優先されてしまうため
# キーは https://platform.openai.com/api-keys で作成。チャットやGitには載せないこと
SHUKATSU_OPENAI_API_KEY=
# 使うモデル。gpt-5-mini（賢い・既定）または gpt-5-nano（さらに安い）
OPENAI_MODEL=gpt-5-mini
# 考える量：minimal / low / medium / high（低いほど速くて安い）。推論しないモデルにしたときは空にする
OPENAI_REASONING_EFFORT=low

# LINE（Messaging API）。LINE Developers の「チャネル基本設定」と「Messaging API設定」で確認。チャットやGitには載せないこと
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 朝のまとめを送る時刻
LINE_MORNING_AT=07:00
